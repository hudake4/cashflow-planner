# Copy to .env. All data stays on this machine; the only remote service is the optional
# read-only Teller bank connection configured below.
# SQLite file path, relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"
# Keep everything local: disable Next.js anonymous telemetry.
NEXT_TELEMETRY_DISABLED=1

# --- Teller bank connections (optional; powers the Institutions page) ---
# Create a free developer account at https://teller.io. Keep the certificate and private key
# OUTSIDE this repo and never commit them. Start with "sandbox" (fake banks, no certificate
# needed), then use "development" (free, real banks) which does need the certificate and key.
# TELLER_APPLICATION_ID="app_xxxxxxxxxxxxxxxxxxxxx"
# TELLER_ENVIRONMENT="sandbox"   # sandbox | development | production
# TELLER_CERT_PATH="C:/secrets/teller/certificate.pem"
# TELLER_KEY_PATH="C:/secrets/teller/private_key.pem"
