# Copy to .env. All data stays on this machine.
# SQLite file path, relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"
# Keep everything local: disable Next.js anonymous telemetry.
NEXT_TELEMETRY_DISABLED=1
# Optional: 32-byte base64 key that encrypts the stored SimpleFIN Access URL on the plain dev/prod server.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Unset = stored as plaintext. The desktop app uses Windows DPAPI instead and ignores this unless DPAPI is unavailable.
# CASHFLOW_SECRET_KEY=
