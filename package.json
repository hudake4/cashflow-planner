{
  "name": "cashflow-planner",
  "version": "0.5.0",
  "private": true,
  "description": "CashFlow Planner — a local personal cash-flow projection app.",
  "author": "Ethan Hudak",
  "main": "electron/dist/main.js",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "node scripts/check-port.mjs && next dev -p 3000",
    "build": "next build",
    "start": "node scripts/check-port.mjs && next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed",
    "desktop:build": "next build && node scripts/prepare-desktop.mjs && tsc -p electron/tsconfig.json",
    "desktop:start": "npm run desktop:build && electron .",
    "desktop:dist": "npm run desktop:build && electron-builder --win nsis",
    "desktop:icon": "node scripts/generate-icon.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "^15.5.28",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^2.15.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "jsdom": "^26.1.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.31"
    }
  }
}
