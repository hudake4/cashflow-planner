// CashFlow Planner data model.
// Conventions (see docs/CONVENTIONS.md):
//   - Money is stored as integer cents (Int). Never floats.
//   - Calendar dates are stored as "YYYY-MM-DD" strings (no time, no timezone).
//   - Enum-like fields are Strings validated by Zod in src/contracts/api.ts.
//   - householdId scopes every row so multi-user support can be added later.
//     The single-user MVP always uses "local".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Settings {
  householdId           String   @id @default("local")
  startingBalanceCents  Int      @default(0)
  startingBalanceSource String   @default("MANUAL") // "MANUAL" | "ACCOUNTS" (sum of connected bank accounts)
  projectionStartDate   String // YYYY-MM-DD; balance is BEFORE any events on this date
  currency              String   @default("USD")
  forecastDays          Int      @default(90)
  weekStartsOn          Int      @default(0) // 0 = Sunday ... 6 = Saturday
  defaultCalendarView   String   @default("month") // "month" | "week"
  desktopNotifications  Boolean  @default(true) // desktop app: notify about low balance and bills due soon (CONVENTIONS section 16)
  balanceFloorCents     Int      @default(0) // lowest projected balance the user wants to stay above (safe-to-spend)
  debtMonthlyPaymentCents Int    @default(50000) // total monthly payment on the Debt payoff page ($500.00 until changed)
  updatedAt             DateTime @updatedAt
}

model IncomeSource {
  id          String   @id @default(cuid())
  householdId String   @default("local")
  name        String
  amountCents Int
  frequency   String // WEEKLY | BIWEEKLY | ONE_TIME
  anchorDate  String // first/next expected payday, YYYY-MM-DD
  endDate     String? // inclusive, YYYY-MM-DD
  active      Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([householdId])
}

model Bill {
  id          String           @id @default(cuid())
  householdId String           @default("local")
  name        String
  amountCents Int
  frequency   String // ONE_TIME | WEEKLY | BIWEEKLY | MONTHLY | QUARTERLY | YEARLY
  anchorDate  String // first/next due date, YYYY-MM-DD
  endDate     String? // inclusive, YYYY-MM-DD
  category    String?
  notes       String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  occurrences BillOccurrence[]

  @@index([householdId])
}

// Per-occurrence status / amount override for a bill. Rows exist only when the user
// has recorded something for a specific due date; absence means UPCOMING with the
// bill's default amount. Keyed by the occurrence's scheduled due date.
model BillOccurrence {
  id                  String   @id @default(cuid())
  billId              String
  dueDate             String // YYYY-MM-DD scheduled date of this occurrence
  status              String   @default("UPCOMING") // UPCOMING | PAID | SKIPPED
  amountOverrideCents Int?
  note                String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  bill                Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([billId, dueDate])
}

// A SimpleFIN Bridge connection. `accessUrl` embeds the credentials (user:password in the
// URL), so it is server-only: only src/server/simplefin.ts and the institutions repository
// read it, and no DTO ever includes it. The value is encrypted at rest when possible
// (src/server/secret-box.ts: `enc:v1:os:` desktop keystore, `enc:v1:key:` CASHFLOW_SECRET_KEY);
// a legacy plain `https://...` value is still read and upgraded on its next sync.
model BankConnection {
  id           String        @id @default(cuid())
  householdId  String        @default("local")
  accessUrl    String
  lastSyncedAt DateTime? // last successful sync; drives the 15-minute minimum between syncs
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  accounts     BankAccount[]

  @@index([householdId])
}

// Latest snapshot of one bank account. id = `${connectionId}:${simplefinAccountId}`.
model BankAccount {
  id                    String            @id
  connectionId          String
  providerAccountId     String // SimpleFIN account id
  institutionName       String // the SimpleFIN connection (bank) name
  name                  String
  kind                  String            @default("BANK") // "BANK" | "CREDIT" | "LOAN" | "OTHER"; user's label, only BANK counts toward the starting balance
  // Credit-card fields (user-entered; SimpleFIN supplies none of them). Null for non-card accounts.
  statementClosingDay   Int? // day of month the statement closes (1-31)
  paymentDueDay         Int? // day of month the payment is due (1-31)
  aprBasisPoints       Int? // APR in basis points (100 = 1.00%), e.g. 2499 = 24.99%
  minimumPaymentRule    String? // optional issuer rule label/text; null means pay in full
  minimumPaymentCents   Int? // real monthly minimum for the Debt payoff planner; null means use its 2% / $25 estimate
  currency              String // 3-letter code, "USD" when SimpleFIN gives a non-ISO currency
  balanceCents          Int
  availableBalanceCents Int?
  balanceDate           String // YYYY-MM-DD (UTC date of SimpleFIN's balance-date)
  connection            BankConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transactions          BankTransaction[]

  @@index([connectionId])
}

// Stored transactions. id = `${accountId}:${simplefinTransactionId}`.
// amountCents is SIGNED like SimpleFIN: money in positive, money out negative
// (the opposite of bills, which are positive magnitudes).
model BankTransaction {
  id          String      @id
  accountId   String
  date        String // YYYY-MM-DD (UTC date of the posted timestamp)
  amountCents Int
  description String
  pending     Boolean
  account     BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, date])
}

// The user's own spend-analyzer category for one transaction. No relation to BankTransaction on
// purpose: a sync deletes and re-inserts rows with the same id, which would cascade the choice away.
// `date` is the transaction's date so rows can be pruned when it leaves the history window.
model TransactionCategory {
  transactionId String   @id
  householdId   String   @default("local")
  category      String // SpendingCategory, validated by Zod
  date          String // YYYY-MM-DD
  updatedAt     DateTime @updatedAt

  @@index([householdId])
}

// What the analyzer has learned: every transaction whose merchant key (the first three words of its
// cleaned-up name, see src/domain/spending.ts) matches gets this category. The latest choice wins.
model MerchantCategoryRule {
  id          String   @id @default(cuid())
  householdId String   @default("local")
  merchantKey String
  category    String // SpendingCategory, validated by Zod
  updatedAt   DateTime @updatedAt

  @@unique([householdId, merchantKey])
}

model SavingsGoal {
  id               String   @id @default(cuid())
  householdId      String   @default("local")
  name             String?
  targetAmountCents Int
  targetDate       String // YYYY-MM-DD
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([householdId])
}

// A recurring charge the user said is not a subscription, so the subscription audit stops
// suggesting it. Keyed by the suggestion's stable `key` (see RecurringSuggestionDTO).
model DismissedRecurring {
  id          String   @id @default(cuid())
  householdId String   @default("local")
  key         String
  createdAt   DateTime @default(now())

  @@unique([householdId, key])
  @@index([householdId])
}
